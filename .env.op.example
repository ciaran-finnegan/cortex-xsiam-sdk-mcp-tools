# 1Password references for the demisto-sdk credentials. Copy to .env.op (git
# ignores it), set your vault and item, then start the server with:
#   op run --env-file=/path/to/.env.op -- /path/to/.venv/bin/python -m mcp_demisto_sdk
# See docs/CREDENTIALS.md.
DEMISTO_BASE_URL=op://Security Engineering/XSIAM dev tenant/url
DEMISTO_API_KEY=op://Security Engineering/XSIAM dev tenant/credential
XSIAM_AUTH_ID=op://Security Engineering/XSIAM dev tenant/auth_id
